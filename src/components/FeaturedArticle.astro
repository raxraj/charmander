---
import type { Article } from "../data/types";

interface Props {
  article: Article;
}

const { article } = Astro.props;
---

<article class="featured-wrapper" aria-label="Featured Article">
  <!-- Top Editorial Header Bar -->
  <div class="featured-header-bar">
    <div class="featured-badge">
      FEATURED ARTICLE / {article.index}
    </div>
    <time class="featured-date" datetime="2026-11-23">
      {article.publishedAt}
    </time>
  </div>

  <!-- Content Split: Text & Cover Illustration -->
  <div class="featured-body-grid">
    <div class="featured-text-col">
      <h3 class="featured-title">
        <span>THE GREAT</span>
        <span>AI BILL</span>
        <span>MYSTERY</span>
      </h3>

      <p class="featured-excerpt">
        {article.excerpt}
      </p>

      <div class="featured-meta-row">
        <a href={`#article-${article.slug}`} class="read-link">
          {article.readingTime} →
        </a>
      </div>
    </div>

    <div class="featured-illustration-col">
      <img
        src={article.coverImage?.src || "/assets/illustrations/featured-bill-mystery.png"}
        alt={article.coverImage?.alt || "Pixel art receipt analysis"}
        class="receipt-illustration pixel-canvas"
        width="236"
        height="374"
        loading="lazy"
      />
    </div>
  </div>
</article>

<style>
  .featured-wrapper {
    display: flex;
    flex-direction: column;
    height: 100%;
    background-color: var(--bg-primary);
  }

  .featured-header-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.65rem 1.5rem;
    border-bottom: 1px solid var(--border-color);
    background-color: var(--bg-primary);
  }

  .featured-badge {
    background-color: var(--accent-blue);
    color: #FFFFFF;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
    padding: 0.25rem 0.5rem;
    letter-spacing: 0.05em;
  }

  .featured-date {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--text-primary);
  }

  .featured-body-grid {
    display: grid;
    grid-template-columns: 1fr 240px;
    flex-grow: 1;
  }

  .featured-text-col {
    padding: 2rem 1.5rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .featured-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.4vw, 3.2rem);
    font-weight: 900;
    line-height: 1.0;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    text-transform: uppercase;
    display: flex;
    flex-direction: column;
    margin-bottom: 1.25rem;
  }

  .featured-excerpt {
    font-family: var(--font-sans);
    font-size: var(--text-base);
    line-height: 1.5;
    color: var(--text-primary);
    margin-bottom: 1.75rem;
  }

  .featured-meta-row {
    margin-top: auto;
  }

  .read-link {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-primary);
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    transition: color 0.1s ease;
  }

  .read-link:hover {
    color: var(--accent-blue);
  }

  .featured-illustration-col {
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--bg-primary);
    overflow: hidden;
  }

  .receipt-illustration {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    image-rendering: pixelated;
  }

  @media (max-width: 680px) {
    .featured-body-grid {
      grid-template-columns: 1fr;
    }
    .featured-illustration-col {
      min-height: 240px;
      border-top: 1px solid var(--border-color);
    }
  }
</style>
