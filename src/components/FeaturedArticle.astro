---
import type { Article } from "../data/types";
import { getArticleHref } from "../lib/article/links";

interface Props {
  article: Article | null;
}

const { article } = Astro.props;
---

<article class="featured-wrapper" aria-label="Featured Article">
  <!-- Top Editorial Header Bar -->
  <div class="featured-header-bar">
    <div class="featured-badge">
      FEATURED ARTICLE {article?.category ? `// ${article.category}` : (article?.index ? `/ ${article.index}` : '')}
    </div>
    {article ? (
      <time class="featured-date" datetime={article.publishedAtRaw}>
        {article.publishedAt}
      </time>
    ) : (
      <span class="featured-date">[ TRANSMISSION STANDBY ]</span>
    )}
  </div>

  <!-- Content Split: Text & Cover Illustration -->
  <div class="featured-body-grid">
    <div class="featured-text-col">
      {article ? (
        <h3 class="featured-title">
          {article.title.includes('\n') ? (
            article.title.split('\n').map((line) => <span>{line}</span>)
          ) : (
            <span>{article.title}</span>
          )}
        </h3>
      ) : (
        <h3 class="featured-title">
          <span>NO PUBLISHED</span>
          <span>ARTICLES YET</span>
        </h3>
      )}

      {article ? (
        article.excerpt && (
          <p class="featured-excerpt">
            {article.excerpt}
          </p>
        )
      ) : (
        <p class="featured-excerpt">
          Nothing has been published to the archive yet. Check back soon for technical investigations, architecture teardowns, and experiments.
        </p>
      )}

      <div class="featured-meta-row">
        {article ? (
          <a href={getArticleHref(article.slug)} class="read-link">
            {article.readingTime ? `${article.readingTime} →` : 'READ DISPATCH →'}
          </a>
        ) : (
          <span class="empty-status-tag">[ ARCHIVE STANDBY ]</span>
        )}
      </div>
    </div>

    <div class="featured-illustration-col">
      <img
        src={article?.coverImage?.src || "/assets/illustrations/featured-bill-mystery.png"}
        alt={article?.coverImage?.alt || (article ? article.title : "Pixel art developer waiting at workstation")}
        class="receipt-illustration pixel-canvas"
        width="236"
        height="374"
        loading="lazy"
      />
    </div>
  </div>
</article>

<style>
  .featured-wrapper {
    display: flex;
    flex-direction: column;
    height: 100%;
    background-color: var(--bg-primary);
  }

  .featured-header-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.65rem 1.5rem;
    border-bottom: 1px solid var(--border-color);
    background-color: var(--bg-primary);
  }

  .featured-badge {
    background-color: var(--accent-blue);
    color: #FFFFFF;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
    padding: 0.25rem 0.5rem;
    letter-spacing: 0.05em;
  }

  .featured-date {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--text-primary);
  }

  .featured-body-grid {
    display: grid;
    grid-template-columns: 1fr 240px;
    flex-grow: 1;
  }

  .featured-text-col {
    padding: 2rem 1.5rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .featured-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.4vw, 3.2rem);
    font-weight: 900;
    line-height: 1.0;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    text-transform: uppercase;
    display: flex;
    flex-direction: column;
    margin-bottom: 1.25rem;
  }

  .featured-excerpt {
    font-family: var(--font-sans);
    font-size: var(--text-base);
    line-height: 1.5;
    color: var(--text-primary);
    margin-bottom: 1.75rem;
  }

  .featured-meta-row {
    margin-top: auto;
  }

  .read-link {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-primary);
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    transition: color 0.1s ease;
  }

  .read-link:hover {
    color: var(--accent-blue);
  }

  .empty-status-tag {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--text-secondary);
    letter-spacing: 0.05em;
  }

  .featured-illustration-col {
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--bg-primary);
    overflow: hidden;
  }

  .receipt-illustration {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    image-rendering: pixelated;
  }

  @media (max-width: 680px) {
    .featured-body-grid {
      grid-template-columns: 1fr;
    }
    .featured-illustration-col {
      min-height: 240px;
      border-top: 1px solid var(--border-color);
    }
  }
</style>
