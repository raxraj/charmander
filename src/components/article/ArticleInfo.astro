---
import type { ArticleDetail } from '../../data/types';

interface Props {
  article: ArticleDetail;
  readingTime: string;
}

const { article, readingTime } = Astro.props;
---

<section class="info-section" aria-label="Article information">
  <h2 class="section-label">ARTICLE INFO</h2>

  <dl class="info-list">
    <div class="info-row">
      <dt>PUBLISHED</dt>
      <dd><time datetime={article.publishedAtRaw || article.publishedAt}>{article.publishedAt}</time></dd>
    </div>
    <div class="info-row">
      <dt>LENGTH</dt>
      <dd>{readingTime}</dd>
    </div>
  </dl>

  {
    article.tags.length > 0 && (
      <div class="info-topics">
        <span class="sub-label">TOPICS //</span>
        <ul class="topic-list">
          {article.tags.map((tag) => (
            <li class="topic-chip">{tag}</li>
          ))}
        </ul>
      </div>
    )
  }

  {
    article.series && (
      <div class="info-series">
        <span class="sub-label">SERIES //</span>
        <p class="series-title">{article.series.title}</p>
        {typeof article.series.position === 'number' && (
          <p class="series-position">PART {article.series.position}</p>
        )}
      </div>
    )
  }
</section>

<style>
  .info-section {
    border: 1px solid var(--border-color);
    background-color: var(--bg-primary);
    padding: 0.85rem;
  }

  .section-label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--color-offwhite);
    background-color: var(--color-black);
    padding: 0.3rem 0.45rem;
    margin: 0 0 0.85rem;
  }

  .info-list {
    margin: 0;
  }

  .info-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.6rem;
    padding: 0.45rem 0;
    border-bottom: 1px solid var(--border-subtle);
  }

  .info-row dt,
  .sub-label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--text-secondary);
  }

  .info-row dd {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
    text-align: right;
    color: var(--text-primary);
  }

  .info-topics,
  .info-series {
    margin-top: 0.9rem;
  }

  .topic-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    list-style: none;
    margin: 0.5rem 0 0;
    padding: 0;
  }

  /* Topic routes are not implemented; these are deliberately non-clickable. */
  .topic-chip {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    border: 1px solid var(--border-color);
    background-color: var(--bg-secondary);
    color: var(--text-primary);
    padding: 0.2rem 0.4rem;
  }

  .series-title {
    margin: 0.45rem 0 0;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--text-primary);
  }

  .series-position {
    margin: 0.2rem 0 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--accent-blue);
    font-weight: 700;
  }
</style>
