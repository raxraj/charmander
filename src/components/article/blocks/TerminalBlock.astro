---
import type { TerminalBlock as TerminalBlockType } from '../../../data/types';

interface Props {
  block: TerminalBlockType;
}

const { block } = Astro.props;
---

<div class="article-block terminal-block">
  <div class="terminal-chrome">
    <span class="terminal-lights" aria-hidden="true">■ ■ ■</span>
    <span>TERMINAL</span>
  </div>
  <pre><code><span class="terminal-prompt">$ </span>{block.command}{block.output ? '\n' + block.output : ''}</code></pre>
  {block.explanation && <p class="block-caption">{block.explanation}</p>}
</div>

<style>
  .terminal-block {
    border: 1px solid var(--border-color);
  }

  .terminal-chrome {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.45rem 0.75rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--color-offwhite);
    background-color: #1a1a1a;
    border-bottom: 1px solid #333;
  }

  .terminal-lights {
    color: var(--color-terminal-green);
    letter-spacing: 0.2rem;
  }

  pre {
    margin: 0;
    padding: 1rem 1.1rem;
    background-color: var(--color-black);
    color: var(--color-terminal-green);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    line-height: 1.6;
    overflow-x: auto;
    white-space: pre;
    -webkit-overflow-scrolling: touch;
  }

  .terminal-prompt {
    color: var(--color-terminal-cyan);
    font-weight: 700;
  }
</style>
