---
import type { CalloutBlock as CalloutBlockType, CalloutVariant } from '../../../data/types';

interface Props {
  block: CalloutBlockType;
}

const { block } = Astro.props;
const marks: Record<CalloutVariant, string> = {
  info: 'i',
  warning: '!',
  success: '✓',
  danger: '×',
};
---

<aside class:list={['article-block', 'callout', `callout-${block.variant}`]}>
  <div class="callout-head">
    <span class="callout-mark" aria-hidden="true">{marks[block.variant]}</span>
    <span class="callout-title">{block.title || block.variant.toUpperCase()}</span>
  </div>
  <p class="callout-content">{block.content}</p>
</aside>

<style>
  .callout {
    border: 2px solid var(--accent-blue);
    border-left-width: 6px;
    padding: 1rem 1.15rem;
    background-color: var(--bg-secondary);
  }

  .callout-head {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.5rem;
  }

  .callout-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: 1.5rem;
    flex: 0 0 1.5rem;
    font-family: var(--font-mono);
    font-weight: 700;
    color: #fff;
    background-color: var(--accent-blue);
  }

  .callout-title {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-primary);
  }

  .callout-content {
    font-family: var(--font-sans);
    font-size: var(--text-base);
    line-height: 1.65;
    color: var(--text-primary);
    white-space: pre-line;
    margin: 0;
  }

  .callout-warning {
    border-color: var(--color-mascot-orange);
  }
  .callout-warning .callout-mark {
    background-color: var(--color-mascot-orange);
    color: var(--color-black);
  }

  .callout-success {
    border-color: var(--color-terminal-green);
  }
  .callout-success .callout-mark {
    background-color: var(--color-terminal-green);
    color: var(--color-black);
  }

  .callout-danger {
    border-color: #d90429;
  }
  .callout-danger .callout-mark {
    background-color: #d90429;
  }
</style>
