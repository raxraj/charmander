---
import type { VideoBlock as VideoBlockType } from '../../../data/types';

interface Props {
  block: VideoBlockType;
}

const { block } = Astro.props;
---

<div class="article-block video-block">
  {
    block.embedUrl ? (
      <div class="video-frame">
        <iframe
          src={block.embedUrl}
          title={block.caption || `${block.provider} video`}
          loading="lazy"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
          referrerpolicy="strict-origin-when-cross-origin"
        ></iframe>
      </div>
    ) : (
      <div class="video-unsupported">
        <span class="block-label">[ UNSUPPORTED VIDEO URL ]</span>
        <p>The CMS supplied a {block.provider} URL that cannot be embedded safely.</p>
        {block.url && <a href={block.url} target="_blank" rel="noopener noreferrer">OPEN SOURCE LINK ↗</a>}
      </div>
    )
  }
  {block.caption && <p class="block-caption">{block.caption}</p>}
</div>

<style>
  .video-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    border: 1px solid var(--border-color);
    background-color: var(--color-black);
  }

  .video-frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .video-unsupported {
    border: 2px dashed var(--border-color);
    background-color: var(--bg-secondary);
    padding: 1.25rem;
    font-family: var(--font-sans);
    color: var(--text-primary);
  }

  .video-unsupported p {
    font-size: var(--text-sm);
    line-height: 1.6;
    margin: 0.75rem 0;
  }

  .video-unsupported a {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    color: var(--accent-blue);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
