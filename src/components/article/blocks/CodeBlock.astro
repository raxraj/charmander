---
import type { CodeBlockData } from '../../../data/types';

interface Props {
  block: CodeBlockData;
}

const { block } = Astro.props;
const label = block.filename || block.title || block.language;
---

<div class="article-block">
  <div class="code-surface">
    <div class="code-toolbar">
      <span class="code-label">{label}</span>
      <button
        type="button"
        class="copy-button"
        data-copy-code
        aria-label="Copy code to clipboard"
      >
        COPY
      </button>
    </div>
    <pre><code data-code>{block.code}</code></pre>
  </div>
  {block.explanation && <p class="block-caption">{block.explanation}</p>}
</div>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy-code]').forEach((button) => {
    button.addEventListener('click', async () => {
      const code = button.closest('.code-surface')?.querySelector('code')?.textContent ?? '';
      try {
        await navigator.clipboard.writeText(code);
        button.textContent = 'COPIED';
        button.setAttribute('aria-label', 'Code copied to clipboard');
        window.setTimeout(() => {
          button.textContent = 'COPY';
          button.setAttribute('aria-label', 'Copy code to clipboard');
        }, 1600);
      } catch {
        button.textContent = 'COPY FAILED';
        button.setAttribute('aria-label', 'Could not copy code');
      }
    });
  });
</script>

<style>
  .copy-button {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--color-black);
    background-color: var(--accent-blue);
    border: 1px solid var(--accent-blue);
    padding: 0.2rem 0.5rem;
    cursor: pointer;
  }

  .copy-button:hover,
  .copy-button:focus-visible {
    color: var(--color-offwhite);
    background-color: transparent;
    outline: 2px solid var(--accent-blue);
    outline-offset: 2px;
  }
</style>
