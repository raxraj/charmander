---
import CharacterScene from "./CharacterScene.astro";
---

<section class="hero-section" aria-label="Hero Introduction">
  <!-- Left Editorial Column -->
  <div class="hero-editorial">
    <div class="category-badge">
      ENGINEERING / IDEAS / EXPERIMENTS
    </div>

    <h2 class="hero-headline">
      <span>MAKING THINGS.</span>
      <span>BREAKING THINGS.</span>
      <span class="headline-with-block">
        WRITING ABOUT BOTH.<span class="headline-blue-block" aria-hidden="true"></span>
      </span>
    </h2>

    <p class="hero-description">
      A technical publication about software, ideas, experiments and the occasional questionable engineering decision.
    </p>

    <div class="hero-cta-wrapper">
      <a href="#writing" class="hero-cta-btn">
        EXPLORE WRITING →
      </a>
    </div>
  </div>

  <!-- Right Character Scene Column -->
  <div class="hero-character-column">
    <CharacterScene />
  </div>
</section>

<style>
  .hero-section {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-bottom: 1px solid var(--border-color);
    background-color: var(--bg-primary);
  }

  .hero-editorial {
    padding: 2.75rem 2.25rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    border-right: 1px solid var(--border-color);
  }

  .category-badge {
    align-self: flex-start;
    display: inline-block;
    background-color: var(--accent-blue);
    color: #FFFFFF;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.05em;
    padding: 0.35rem 0.65rem;
    margin-bottom: 1.5rem;
    text-transform: uppercase;
  }

  .hero-headline {
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 4.4vw, 3.8rem);
    font-weight: 900;
    line-height: 1.02;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    text-transform: uppercase;
    display: flex;
    flex-direction: column;
    margin-bottom: 1.5rem;
  }

  .headline-with-block {
    display: inline-flex;
    align-items: baseline;
    gap: 0.35rem;
    flex-wrap: wrap;
  }

  .headline-blue-block {
    display: inline-block;
    width: 0.38em;
    height: 0.38em;
    background-color: var(--accent-blue);
    flex-shrink: 0;
  }

  .hero-description {
    font-family: var(--font-sans);
    font-size: clamp(0.95rem, 1.2vw, 1.125rem);
    line-height: 1.5;
    color: var(--text-primary);
    max-width: 480px;
    margin-bottom: 2rem;
  }

  .hero-cta-wrapper {
    display: flex;
  }

  .hero-cta-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    background-color: var(--accent-blue);
    color: #FFFFFF;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 700;
    padding: 0.85rem 1.65rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    transition: background-color 0.1s ease;
  }

  .hero-cta-btn:hover {
    background-color: var(--accent-blue-hover);
  }

  .hero-character-column {
    display: flex;
    align-items: stretch;
    justify-content: center;
    background-color: var(--bg-primary);
    overflow: hidden;
  }

  @media (max-width: 900px) {
    .hero-section {
      grid-template-columns: 1fr;
    }
    .hero-editorial {
      border-right: none;
      border-bottom: 1px solid var(--border-color);
      padding: 2rem 1.25rem;
    }
    .hero-character-column {
      min-height: 320px;
    }
  }
</style>
