---
import type { ObsessionItem } from "../data/types";

interface Props {
  items: ObsessionItem[];
}

const { items } = Astro.props;
---

<div class="obsessed-cell" aria-label="Currently Obsessed Topics">
  <div class="obsessed-header-block">
    THINGS I'M<br />CURRENTLY OBSESSED WITH:
  </div>

  <div class="obsessed-list-wrapper">
    <ul class="obsessed-list">
      {items.map((item) => (
        <li class="obsessed-item">
          <span class="prompt-symbol">&gt;</span>
          <span class="item-text">{item.title}</span>
        </li>
      ))}
    </ul>
  </div>
</div>

<style>
  .obsessed-cell {
    display: flex;
    flex-direction: column;
    height: 100%;
    background-color: var(--bg-primary);
  }

  .obsessed-header-block {
    background-color: var(--accent-blue);
    color: #FFFFFF;
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 800;
    line-height: 1.25;
    padding: 0.85rem 1.25rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    border-bottom: 1px solid var(--border-color);
  }

  .obsessed-list-wrapper {
    padding: 1.25rem;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .obsessed-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .obsessed-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--text-primary);
  }

  .prompt-symbol {
    color: var(--text-primary);
    font-weight: 700;
  }

  .item-text {
    color: var(--text-primary);
  }
</style>
