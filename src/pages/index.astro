---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navigation from "../components/Navigation.astro";
import BrandHeader from "../components/BrandHeader.astro";
import Hero from "../components/Hero.astro";
import FeaturedArticle from "../components/FeaturedArticle.astro";
import RecentWriting from "../components/RecentWriting.astro";
import Footer from "../components/Footer.astro";

import {
  siteMetaFixture,
  currentlyObsessedFixture
} from "../data/fixtures";

import { getHomepageArticles } from "../lib/strapi";

// Fetch published articles from Strapi during Astro SSG build
const { featuredArticle, recentArticles, error } = await getHomepageArticles();
---

<BaseLayout
  title="SOURCASTIC. / DEV BLOGS — Thoughts, experiments & occasional bad decisions"
  description={siteMetaFixture.description}
>
  <main class="homepage-frame">
    <!-- 1. Top Compact Navigation Bar -->
    <Navigation navItems={siteMetaFixture.navigation} />

    <!-- 2. Brand Masthead / Wordmark -->
    <BrandHeader meta={siteMetaFixture} />

    <!-- 3. Hero Section (50/50 Split Grid) -->
    <Hero />

    <!-- CMS Diagnostic Notification (renders only when Strapi is unreachable or encounters errors) -->
    {error && (
      <aside class="cms-diagnostic-banner" role="alert">
        <span class="diagnostic-badge">CMS DIAGNOSTIC // {error.kind.toUpperCase()}</span>
        <p class="diagnostic-message">{error.message}</p>
      </aside>
    )}

    <!-- 4. Featured Article (Left) + Recent Writing (Right) Grid -->
    <section class="editorial-middle-grid" aria-label="Featured and Recent Articles">
      <div class="middle-featured-col">
        <FeaturedArticle article={featuredArticle} />
      </div>
      <div class="middle-recent-col">
        <RecentWriting articles={recentArticles} />
      </div>
    </section>

    <!-- 5. Bottom Section: Obsessions + Mascot Scene + Publication Footer -->
    <Footer
      obsessedItems={currentlyObsessedFixture}
      meta={siteMetaFixture}
    />
  </main>
</BaseLayout>

<style>
  .homepage-frame {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border-color);
    background-color: var(--bg-primary);
    width: 100%;
  }

  /* Diagnostic Banner */
  .cms-diagnostic-banner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    padding: 0.85rem 1.5rem;
    background-color: var(--color-black);
    color: var(--color-offwhite);
    border-bottom: 2px solid var(--accent-blue);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .diagnostic-badge {
    background-color: #d90429;
    color: #ffffff;
    font-weight: 700;
    padding: 0.25rem 0.5rem;
    letter-spacing: 0.05em;
  }

  .diagnostic-message {
    margin: 0;
    line-height: 1.4;
    color: var(--color-offwhite);
  }

  /* Middle Split Grid */
  .editorial-middle-grid {
    display: grid;
    grid-template-columns: 1.14fr 1fr;
    border-bottom: 1px solid var(--border-color);
    background-color: var(--bg-primary);
  }

  .middle-featured-col {
    border-right: 1px solid var(--border-color);
  }

  @media (max-width: 900px) {
    .editorial-middle-grid {
      grid-template-columns: 1fr;
    }
    .middle-featured-col {
      border-right: none;
      border-bottom: 1px solid var(--border-color);
    }
  }
</style>
