---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';
import ArticleContent from '../../components/article/ArticleContent.astro';
import ArticleSidebarLeft from '../../components/article/ArticleSidebarLeft.astro';
import ArticleSidebarRight from '../../components/article/ArticleSidebarRight.astro';

import { siteMetaFixture, currentlyObsessedFixture } from '../../data/fixtures';
import { prepareArticleForReading } from '../../lib/article/reading';
import {
  getPublishedArticleSlugs,
  getArticleBySlug,
  getRelatedArticles,
  transformArticleDetail,
} from '../../lib/strapi';

export async function getStaticPaths() {
  const { slugs, error } = await getPublishedArticleSlugs();
  if (error) {
    console.warn(`[articles] Could not load published slugs: ${error.message}`);
    return [];
  }
  return slugs.map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;

const { article: rawArticle, error } = slug
  ? await getArticleBySlug(slug)
  : { article: null, error: null };

// Unknown or unpublished slugs must not render an empty article template.
if (!rawArticle) {
  if (error) console.warn(`[articles] ${error.message}`);
  return Astro.redirect('/404');
}

const article = transformArticleDetail(rawArticle);
const reading = prepareArticleForReading(article.blocks);
const related = await getRelatedArticles(article.slug, article.topicSlugs, 3);
const pageTitle = `${article.seo.title} — SOURCASTIC. / DEV BLOGS`;
---

<BaseLayout
  title={pageTitle}
  description={article.seo.description}
  canonical={article.seo.canonicalUrl}
  ogTitle={article.seo.title}
  ogDescription={article.seo.description}
  ogImage={article.seo.image}
  ogType="article"
  publishedTime={article.publishedAtRaw}
>
  <main class="homepage-frame article-frame">
    <Navigation navItems={siteMetaFixture.navigation} />

    <div class="article-editorial-grid">
      <aside class="article-col-left" aria-label="Article navigation">
        <ArticleSidebarLeft
          headings={reading.headings}
          readingTime={reading.readingTime}
          wordCount={reading.wordCount}
        />
      </aside>

      <article class="article-shell article-reading-area" aria-labelledby="article-title">
      <header class="article-header">
        <div class="article-kicker">
          <span class="kicker-badge">
            {article.category ? `// ${article.category}` : '// DISPATCH'}
          </span>
          <time class="article-date" datetime={article.publishedAtRaw || article.publishedAt}>
            {article.publishedAt}
          </time>
        </div>

        <h1 id="article-title" class="article-title">{article.title}</h1>

        {article.excerpt && <p class="article-excerpt">{article.excerpt}</p>}

        <div class="article-meta-strip">
          <span>SOURCASTIC. / DEV BLOGS</span>
          <span aria-hidden="true">•</span>
          <span>EST. 2026</span>
        </div>
      </header>

      {
        article.coverImage && (
          <figure class="article-cover">
            <img
              src={article.coverImage.src}
              srcset={article.coverImage.srcSet}
              alt={article.coverImage.alt}
              sizes="(max-width: 900px) 100vw, 760px"
              width="1200"
              height="630"
            />
            {article.coverImage.caption && (
              <figcaption>{article.coverImage.caption}</figcaption>
            )}
          </figure>
        )
      }

      <div class="article-body">
        <ArticleContent blocks={reading.blocks} />
      </div>

      <footer class="article-end">
        {
          article.tags.length > 0 && (
            <div class="article-tags" aria-label="Article topics">
              <span class="tags-label">TOPICS //</span>
              {article.tags.map((tag) => (
                <span class="tag-chip">{tag}</span>
              ))}
            </div>
          )
        }
        <nav class="article-return" aria-label="Article navigation">
          <a href="/">← BACK TO HOMEPAGE</a>
          <a href="/#writing">MORE WRITING →</a>
        </nav>
      </footer>
      </article>

      <aside class="article-col-right" aria-label="Article context">
        <ArticleSidebarRight
          article={article}
          related={related}
          readingTime={reading.readingTime}
          shareUrl={article.seo.canonicalUrl || '/'}
        />
      </aside>
    </div>

    <Footer obsessedItems={currentlyObsessedFixture} meta={siteMetaFixture} />
  </main>
</BaseLayout>

<style>
  .article-frame {
    min-height: 100%;
  }

  /* Three-column editorial workspace */
  .article-editorial-grid {
    display: grid;
    grid-template-columns: 232px minmax(0, 1fr) 264px;
    column-gap: 2.25rem;
    row-gap: 1.5rem;
    align-items: start;
    max-width: 1640px;
    margin: 0 auto;
    padding: 1.5rem 1.75rem 3rem;
  }

  .article-col-left,
  .article-col-right {
    min-width: 0;
    position: sticky;
    top: 1.5rem;
    max-height: calc(100vh - 3rem);
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
  }

  .article-shell {
    display: block;
    width: 100%;
    min-width: 0;
    border-bottom: 1px solid var(--border-color);
    background-color: var(--bg-primary);
  }

  .article-header {
    max-width: 760px;
    margin: 0 auto;
    padding: 2.25rem 0 1.75rem;
  }

  .article-kicker {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    flex-wrap: wrap;
    margin-bottom: 1.5rem;
  }

  .kicker-badge {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #fff;
    background-color: var(--accent-blue);
    padding: 0.3rem 0.55rem;
  }

  .article-date {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-secondary);
  }

  .article-title {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 5vw, 4.25rem);
    font-weight: 900;
    line-height: 1.02;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    color: var(--text-primary);
    margin: 0 0 1.25rem;
  }

  .article-excerpt {
    font-family: var(--font-sans);
    font-size: var(--text-lg);
    line-height: 1.6;
    color: var(--text-secondary);
    margin: 0 0 1.5rem;
  }

  .article-meta-strip {
    display: flex;
    gap: 0.6rem;
    align-items: center;
    padding-top: 0.85rem;
    border-top: 1px solid var(--border-color);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--text-muted);
  }

  .article-cover {
    max-width: 760px;
    margin: 0 auto 2.5rem;
    padding: 0;
  }

  .article-cover img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--border-color);
    image-rendering: pixelated;
  }

  .article-cover figcaption {
    margin-top: 0.6rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-secondary);
  }

  .article-body {
    max-width: 760px;
    margin: 0 auto;
    padding: 0 0 1rem;
  }

  .article-end {
    max-width: 760px;
    margin: 0 auto;
    padding: 1.5rem 0 2rem;
  }

  .article-tags {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    padding: 0.9rem 0;
    border-top: 1px solid var(--border-color);
    border-bottom: 1px solid var(--border-color);
    margin-bottom: 1.5rem;
  }

  .tags-label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--text-secondary);
    margin-right: 0.25rem;
  }

  .tag-chip {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    border: 1px solid var(--border-color);
    background-color: var(--bg-secondary);
    color: var(--text-primary);
    padding: 0.25rem 0.5rem;
  }

  .article-return {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .article-return a {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 700;
    text-transform: uppercase;
    color: var(--accent-blue);
  }

  .article-return a:hover {
    color: var(--text-primary);
  }

  @media (max-width: 1199px) {
    .article-editorial-grid {
      grid-template-columns: 210px minmax(0, 1fr);
      column-gap: 2rem;
    }
    .article-col-right {
      grid-column: 1 / -1;
      position: static;
      max-height: none;
      overflow: visible;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1rem;
      border-top: 1px solid var(--border-color);
      padding-top: 1.25rem;
    }
  }

  @media (max-width: 899px) {
    .article-editorial-grid {
      grid-template-columns: minmax(0, 1fr);
      padding: 1rem 1rem 2.5rem;
    }
    .article-col-left,
    .article-col-right {
      position: static;
      max-height: none;
      overflow: visible;
    }
    .article-col-left { order: 1; }
    .article-shell { order: 2; }
    .article-col-right {
      order: 3;
      grid-column: 1;
      grid-template-columns: minmax(0, 1fr);
    }
    .article-header { padding-top: 1.5rem; }
  }

  @media (max-width: 600px) {
    .article-editorial-grid {
      padding-left: 0.85rem;
      padding-right: 0.85rem;
    }
    .article-header { padding-top: 1.25rem; }
  }
</style>
